{
  "info": {
    "name": "AraraHQ API",
    "description": "Postman collection for the AraraHQ API. AraraHQ: WhatsApp for Brazilian companies. Team inbox with AI, campaigns and systems connected through the API.\n\nBase URL: https://api.ararahq.com\nDocs: https://docs.ararahq.com\n\n## Authentication\n\nAll requests use Bearer token auth with your API key:\n```\nAuthorization: Bearer ara_live_...\n```\n\nSet the `api_key` variable in the Variables tab and all requests inherit it automatically.\n\nEvery key is a production key (`ara_live_...`): requests send real messages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ararahq"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.ararahq.com",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Messages",
      "description": "Send and track WhatsApp messages.",
      "item": [
        {
          "name": "Send Template Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{base_url}}/v1/messages", "host": ["{{base_url}}"], "path": ["v1", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"whatsapp:+5511999999999\",\n  \"templateName\": \"hello_world\",\n  \"variables\": [\"João\"]\n}"
            }
          }
        },
        {
          "name": "Send Freeform Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/messages", "host": ["{{base_url}}"], "path": ["v1", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"whatsapp:+5511999999999\",\n  \"body\": \"Hello from Arara!\"\n}"
            }
          }
        },
        {
          "name": "Send Message with Media",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/messages", "host": ["{{base_url}}"], "path": ["v1", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"whatsapp:+5511999999999\",\n  \"templateName\": \"invoice_ready\",\n  \"variables\": [\"João\", \"Janeiro\"],\n  \"media_url\": \"https://example.com/invoice.pdf\"\n}"
            }
          }
        },
        {
          "name": "Send Scheduled Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/messages", "host": ["{{base_url}}"], "path": ["v1", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"whatsapp:+5511999999999\",\n  \"templateName\": \"reminder\",\n  \"variables\": [\"João\"],\n  \"scheduledAt\": \"2026-04-10T10:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Get Message Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/messages/:internalId", "host": ["{{base_url}}"], "path": ["v1", "messages", ":internalId"], "variable": [{ "key": "internalId", "value": "ara_msg_xxxxx" }] }
          }
        }
      ]
    },
    {
      "name": "Templates",
      "description": "Manage WhatsApp message templates.",
      "item": [
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/templates", "host": ["{{base_url}}"], "path": ["v1", "templates"] }
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/templates", "host": ["{{base_url}}"], "path": ["v1", "templates"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"order_confirmation\",\n  \"category\": \"UTILITY\",\n  \"body\": \"Hi {{1}}, your order #{{2}} has been confirmed!\",\n  \"language\": \"en\",\n  \"samples\": {\n    \"1\": \"John\",\n    \"2\": \"12345\"\n  }\n}"
            }
          }
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/templates/:id", "host": ["{{base_url}}"], "path": ["v1", "templates", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Get Template Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/templates/:id/status", "host": ["{{base_url}}"], "path": ["v1", "templates", ":id", "status"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Get Template Analytics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/templates/:id/analytics", "host": ["{{base_url}}"], "path": ["v1", "templates", ":id", "analytics"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/v1/templates/:id", "host": ["{{base_url}}"], "path": ["v1", "templates", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
    {
      "name": "Campaigns",
      "description": "Bulk messaging campaigns.",
      "item": [
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{base_url}}/v1/campaigns", "host": ["{{base_url}}"], "path": ["v1", "campaigns"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Welcome Campaign\",\n  \"templateName\": \"hello_world\",\n  \"contacts\": [\n    {\n      \"to\": \"whatsapp:+5511999999999\",\n      \"variables\": [\"João\"]\n    },\n    {\n      \"to\": \"whatsapp:+5511988888888\",\n      \"variables\": [\"Maria\"]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Campaigns",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/campaigns", "host": ["{{base_url}}"], "path": ["v1", "campaigns"] }
          }
        },
        {
          "name": "Get Campaign",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/campaigns/:id", "host": ["{{base_url}}"], "path": ["v1", "campaigns", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Estimate Campaign Cost",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/campaigns/estimate?templateName=hello_world&count=100", "host": ["{{base_url}}"], "path": ["v1", "campaigns", "estimate"], "query": [{ "key": "templateName", "value": "hello_world" }, { "key": "count", "value": "100" }] }
          }
        },
        {
          "name": "Import Campaign (CSV)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/v1/campaigns/import", "host": ["{{base_url}}"], "path": ["v1", "campaigns", "import"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "templateName", "value": "hello_world", "type": "text" },
                { "key": "name", "value": "CSV Campaign", "type": "text" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "description": "Manage inbound conversations and replies.",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/conversations?page=0&size=20", "host": ["{{base_url}}"], "path": ["v1", "conversations"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/conversations/:conversationId/messages?page=0&size=50", "host": ["{{base_url}}"], "path": ["v1", "conversations", ":conversationId", "messages"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "50" }], "variable": [{ "key": "conversationId", "value": "" }] }
          }
        },
        {
          "name": "Reply to Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/conversations/:conversationId/reply", "host": ["{{base_url}}"], "path": ["v1", "conversations", ":conversationId", "reply"], "variable": [{ "key": "conversationId", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Thanks for reaching out! How can I help?\"\n}"
            }
          }
        },
        {
          "name": "Send Template via Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/conversations/send-template", "host": ["{{base_url}}"], "path": ["v1", "conversations", "send-template"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+5511999999999\",\n  \"templateName\": \"follow_up\",\n  \"variables\": [\"João\"]\n}"
            }
          }
        }
      ]
    },
